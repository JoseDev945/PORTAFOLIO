# Copy to .env.local (and add the same variables in Vercel → Settings → Environment Variables).
# A TURN relay lets phones on mobile data join rooms. Free option: metered.ca
# (create an app, then copy its name and the API key of "TURN Server").
VITE_METERED_APP=
VITE_METERED_KEY=

# Or any TURN provider with fixed credentials (comma separated urls):
# VITE_TURN_URLS=turn:example.com:3478,turns:example.com:443
# VITE_TURN_USERNAME=
# VITE_TURN_CREDENTIAL=
